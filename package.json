{
  "name": "valuefin-desk-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Valuefin Desk — internal lending operations API (Express + MySQL, port 4001). Borrowers, drawdowns, payments, auto ledger + MIS, document approval, audit trail.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext js,sql --exec node src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:reset": "node src/db/migrate.js --reset",
    "db:check": "node src/db/check.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "4.4.0",
    "express": "4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "multer": "2.0.2",
    "mysql2": "^3.11.5",
    "pdfjs-dist": "4.10.38",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
