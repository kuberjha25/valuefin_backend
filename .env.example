# Valuefin Desk API — copy to .env and fill in. Never commit .env.

# Runtime environment: development | production | test
NODE_ENV=development
# Interface to bind. Keep 127.0.0.1 behind a reverse proxy.
HOST=127.0.0.1
PORT=4001
# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=valuefin_app
# Required
DB_PASSWORD=CHANGE_ME
# Required
DB_NAME=valuefin
DB_POOL_SIZE=10

# Sessions and password hashing
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12

# Initial staff account passwords (used only when the users table is empty)
SEED_DIRECTOR_PASSWORD=CHANGE_ME
SEED_MANAGER_PASSWORD=CHANGE_ME
SEED_ANALYST_PASSWORD=CHANGE_ME

# Underwriting ingestion limits (safety limits, not credit policy)
UW_MAX_FILE_MB=40
UW_MAX_BATCH_FILES=20
UW_ZIP_MAX_DEPTH=2
UW_ZIP_MAX_ENTRIES=300
UW_ZIP_MAX_ENTRY_MB=40
UW_ZIP_MAX_TOTAL_MB=400
UW_ZIP_MAX_RATIO=100
UW_MAX_PDF_PAGES=500
UW_MAX_SHEET_CELLS=200000
# Optional path to the ClamAV clamscan binary. Empty = files recorded as "not scanned".
UW_CLAMSCAN_PATH=
